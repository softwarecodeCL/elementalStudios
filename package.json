{
  "name": "elemental-studios",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/astro.mjs dev --host 127.0.0.1 --port 4200",
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1 --port 4200",
    "check": "node scripts/astro.mjs check",
    "test": "node --test scripts/verify-build.mjs scripts/diagnostic.test.mjs scripts/corporate-brief.test.mjs",
    "build": "node scripts/astro.mjs check && node scripts/astro.mjs build",
