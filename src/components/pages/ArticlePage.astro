---
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import { getMessages, localizedPath } from '../../i18n/index.js';
import { getGrowthMessages } from '../../i18n/growth.js';
import { site } from '../../data/site';
interface Props { locale?: string; slug: string; }
const { locale = 'es', slug } = Astro.props;
const article = getMessages(locale).articles.find(item => item.slug === slug);
if (!article) throw new Error(`Unknown article: ${slug}`);
const g = getGrowthMessages(locale);
const related = slug === 'evaluar-ingles-equipo-hotelero'
  ? [[g.hotel, '/idiomas-para-hoteleria'], [g.diagnostic, '/diagnostico-toeic']]
  : slug === 'capacitacion-idiomas-turnos'
    ? [[g.english, '/ingles-para-empresas'], [g.portuguese, '/portugues-para-empresas']]
    : [[g.hotel, '/idiomas-para-hoteleria'], [g.english, '/ingles-para-empresas']];
const articleData = {
  '@type': 'Article', headline: article.title, description: article.description,
  image: new URL(`/images/${article.image}.webp`, site.url).href,
  mainEntityOfPage: new URL(localizedPath(locale, `/noticias/${slug}`), site.url).href,
  author: { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.name, url: site.url + '/nosotros/' },
  publisher: { '@id': `${site.url}/#organization` },
};
---
<Layout locale={locale} title={`${article.title} | Elemental Studios`} description={article.description} image={`/images/${article.image}.webp`} ogType="article" structuredData={articleData} breadcrumbs={[{name: getMessages(locale).common.home, url: localizedPath(locale)}, {name: article.title, url: localizedPath(locale, `/noticias/${slug}`)}]}>
  <article class="article-page"><a class="article-back" href={localizedPath(locale)}><Icon name="arrow" class="rotate" size={17} />{article.back}</a><p class="eyebrow">{article.eyebrow}</p><h1>{article.title}</h1><p class="article-lead">{article.lead}</p><p class="article-byline"><a href={localizedPath(locale, '/nosotros')}>{site.legalName}</a> · {g.organization}</p><img class="article-cover" src={`/images/${article.image}.webp`} width="1000" height="600" alt={article.alt} fetchpriority="high" />{article.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}<nav class="article-related" aria-label={g.viewPrograms}>{related.map(([label, href]) => <a href={localizedPath(locale, href)}>{label} →</a>)}</nav><div class="article-cta"><a class="text-link" href={localizedPath(locale) + '#contacto'}>{article.cta}<Icon name="arrow" size={18} /></a></div></article>
</Layout>
