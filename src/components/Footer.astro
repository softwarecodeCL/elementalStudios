---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getGrowthMessages } from '../i18n/growth.js';
import { getCreditMessages } from '../i18n/credit.js';
import { getMessages, localizedPath } from '../i18n/index.js';
interface Props { locale?: string; }
const { locale = 'es' } = Astro.props;
const t = getMessages(locale);
const g = getGrowthMessages(locale);
const credit = getCreditMessages(locale);
const home = localizedPath(locale);
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand"><a class="brand" href={home} aria-label={t.common.brandHome}><img src="/brand/logo.png" width="290" height="73" alt="Elemental Studios" loading="lazy" /></a><p>{t.footer.tagline}</p><p class="footer-legal"><strong>{site.legalName}</strong><br />{g.rut}: {site.taxId}<br />{g.organization}</p><a class="footer-sence" href={localizedPath(locale, '/capacitacion-sence')} aria-label={g.senceLink}><img src="/brand/sence.png" width="1207" height="558" alt="SENCE — Servicio Nacional de Capacitación y Empleo" loading="lazy" decoding="async" /></a></div>
    <div class="footer-column"><span>{g.languages}</span><a href={localizedPath(locale, '/ingles-para-empresas')}>{g.english}</a><a href={localizedPath(locale, '/portugues-para-empresas')}>{g.portuguese}</a><a href={localizedPath(locale, '/portugues-para-negocios')}>{g.businessPortuguese}</a><a href={localizedPath(locale, '/capacitacion-sence')}>{g.senceLink}</a><a href={localizedPath(locale, '/diagnostico-toeic')}>{t.footer.diagnostic}</a><a href={localizedPath(locale, '/diagnostico-ingles-empresas')}>{g.corporateDiagnostic}</a></div>
    <div class="footer-column"><span>{g.sectors}</span><a href={localizedPath(locale, '/idiomas-para-hoteleria')}>{g.hotel}</a><a href={localizedPath(locale, '/idiomas-para-restaurantes')}>{g.restaurant}</a><a href={localizedPath(locale, '/idiomas-para-turismo')}>{g.tourism}</a><a href={localizedPath(locale, '/recursos')}>{g.resources}</a></div>
    <div class="footer-column"><span>{t.footer.connect}</span><a href={localizedPath(locale, '/nosotros')}>{g.about}</a><a href={site.whatsapp} target="_blank" rel="noopener noreferrer">{t.footer.whatsapp} <Icon name="external" size={14} /></a><a href={`tel:${site.telephone}`}>+56 9 8241 4460</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="external" size={14} /></a><a href={site.moodle} target="_blank" rel="noopener noreferrer">{t.footer.students} <Icon name="external" size={14} /></a></div>
  </div>
  <div class="container footer-bottom"><p>© {new Date().getFullYear()} {site.legalName}. {t.footer.rights}</p><a class="developer-credit" href="https://softwarecode.cl/" target="_blank" rel="noopener noreferrer" aria-label={credit.accessible}><span class="developer-symbol" aria-hidden="true">{'</>'}</span><span class="developer-credit-copy"><span class="developer-credit-label">{credit.label}</span><strong>softwarecode<span>.cl</span></strong></span><Icon name="external" size={14} /></a></div>
</footer>
<style>
  .developer-credit {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    padding: 8px 11px;
    border: 1px solid #3652688c;
    border-radius: 9px;
    background: linear-gradient(125deg, #112b3e99, #07192788);
    color: #dce7ef;
    text-align: left;
    flex-shrink: 0;
    transition: border-color .2s, background .2s;
  }
  .developer-symbol {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid #b99b6559;
    border-radius: 7px;
    background: #e4b7610b;
    color: var(--gold);
    font: 650 13px/1 ui-monospace, SFMono-Regular, Consolas, monospace;
    letter-spacing: -.1em;
  }
  .developer-credit-copy { display: block; }
  .developer-credit-label {
    display: block;
    margin-bottom: 3px;
    color: #a5b9c9;
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: .03em;
  }
  .developer-credit strong {
    display: block;
    font: 750 14px/1.25 var(--heading);
    letter-spacing: -.035em;
  }
  .developer-credit strong span { color: var(--gold); }
  .developer-credit > svg { color: #86a4bb; margin-left: 4px; }
  .developer-credit:hover, .developer-credit:focus-visible {
    border-color: #caa35e;
    background: #173246;
  }
  .developer-credit:hover > svg { color: var(--gold); }
  @media (max-width: 680px) {
    .footer-bottom { flex-direction: column; align-items: flex-start; gap: 16px; }
    .developer-credit { max-width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .developer-credit { transition: none; }
  }
  .footer-sence {
    width: 176px;
    margin-top: 20px;
    padding: 12px;
    background: #fff;
    border-radius: 5px;
    flex-shrink: 0;
  }
  .footer-sence img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (min-width: 541px) and (max-width: 800px) {
    .footer-brand { flex-wrap: wrap; }
    .footer-sence { margin-top: 0; }
  }
</style>
