---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getGrowthMessages } from '../i18n/growth.js';
import { getCommercialMessages } from '../i18n/commercial/index.js';
import { getMessages } from '../i18n/index.js';
interface Props { locale?: string; }
const { locale = 'es' } = Astro.props;
const t = getMessages(locale);
const c = t.contact;
const g = getGrowthMessages(locale);
const programLabels = Object.fromEntries(Object.entries(getCommercialMessages(locale).pages).map(([slug, page]) => [slug, page.title.split(' | ')[0]]));
const sectorIds = ['hoteleria', 'turismo', 'restaurantes'];
---
<section class="contact-section section-space" id="contacto" aria-labelledby="contact-title">
  <div class="container contact-layout">
    <div class="contact-intro">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="contact-title">{c.title}<br /><span class="text-gold">{c.accent}</span></h2>
      <p>{c.intro}</p>
      <a class="text-link" href={site.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={22} />{c.direct}<Icon name="arrow" size={18} /></a>
      <div class="contact-note"><Icon name="shield" size={23} /><span>{c.note}</span></div>
    </div>
    <form id="contact-form" class="contact-form" data-phone={site.whatsappNumber} data-locale={locale} data-program-labels={JSON.stringify(programLabels)} data-contact-copy={JSON.stringify(c)} data-growth-copy={JSON.stringify({program: g.program, senceLabel: g.senceLabel, yes: g.yes})}>
      <div class="form-heading"><span class="form-heading-icon"><Icon name="message" size={23} /></span><div><h3>{c.formTitle}</h3><p>{c.formIntro}</p></div></div>
      <div class="form-program" data-program-summary hidden><span>{g.program}</span><strong data-program-name></strong></div>
      <input type="hidden" name="program" value="" />
      <div class="form-grid">
        <label>{c.name}<span aria-hidden="true"> *</span><input name="name" autocomplete="name" placeholder={c.namePlaceholder} required maxlength="100" /></label>
        <label>{c.company}<span aria-hidden="true"> *</span><input name="company" autocomplete="organization" placeholder={c.companyPlaceholder} required maxlength="120" /></label>
        <label class="form-wide">{c.email}<span aria-hidden="true"> *</span><input type="email" name="email" autocomplete="email" placeholder={c.emailPlaceholder} required maxlength="160" /></label>
        <label>{c.sector}<span aria-hidden="true"> *</span><select name="sector" id="contact-sector" required><option value="" disabled selected>{c.selectSector}</option>{sectorIds.map((id,index) => <option value={id}>{t.programs.sectors[index].name}</option>)}<option value="otra-empresa">{c.otherSector}</option></select></label>
        <label>{c.language}<span aria-hidden="true"> *</span><select name="language" id="contact-language" required><option value="" disabled selected>{c.selectLanguage}</option><option value="ingles">{c.english}</option><option value="portugues">{c.portuguese}</option><option value="ambos">{c.both}</option></select></label>
        <label class="form-wide">{c.needs}<span class="optional">{t.common.optional}</span><textarea name="message" rows="3" maxlength="1200" placeholder={c.messagePlaceholder}></textarea></label>
      </div>
      <label class="sence-checkbox"><input type="checkbox" name="sence" /><span>{g.senceInterest}</span></label>
      <button class="button button-gold form-submit" type="submit"><Icon name="whatsapp" size={20} />{c.submit}<Icon name="arrow" size={19} /></button>
      <p class="form-help">{c.help}</p>
      <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      <noscript><p><a href={site.whatsapp}>{c.noJs}</a></p></noscript>
    </form>
  </div>
</section>
<script>
  import { recordEvent } from '../scripts/measurement';
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#form-status');
  const c: typeof import('../i18n/es.js').default.contact = JSON.parse(form?.dataset.contactCopy || '{}');
  const g: {program: string; senceLabel: string; yes: string} = JSON.parse(form?.dataset.growthCopy || '{}');
  const programLabels: Record<string, string> = JSON.parse(form?.dataset.programLabels || '{}');
  const parameters = new URLSearchParams(window.location.search);
  const requestedProgram = parameters.get('program') || '';
  const requestedSector = parameters.get('sector') || '';
  const requestedLanguage = parameters.get('language') === 'both' ? 'ambos' : parameters.get('language') || '';
  if (Object.hasOwn(programLabels, requestedProgram)) {
    const field = form?.querySelector<HTMLInputElement>('[name="program"]');
    const summary = form?.querySelector<HTMLElement>('[data-program-summary]');
    const name = form?.querySelector<HTMLElement>('[data-program-name]');
    if (field) field.value = requestedProgram;
    if (name) name.textContent = programLabels[requestedProgram];
    if (summary) summary.hidden = false;
  }
  const sectorInput = form?.querySelector<HTMLSelectElement>('[name="sector"]');
  const languageInput = form?.querySelector<HTMLSelectElement>('[name="language"]');
  if (sectorInput && Array.from(sectorInput.options).some(option => option.value === requestedSector)) sectorInput.value = requestedSector;
  if (languageInput && ['ingles', 'portugues', 'ambos'].includes(requestedLanguage)) languageInput.value = requestedLanguage;
  const senceInput = form?.querySelector<HTMLInputElement>('[name="sence"]');
  if (senceInput && requestedProgram === 'capacitacion-sence') senceInput.checked = true;
  form?.addEventListener('submit', event => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const sector = form.querySelector<HTMLSelectElement>('[name="sector"]')?.selectedOptions[0]?.textContent;
    const language = form.querySelector<HTMLSelectElement>('[name="language"]')?.selectedOptions[0]?.textContent;
    const labels = c.messageLabels;
    const program = String(data.get('program') || '');
    const message = [c.whatsappIntro,
      labels.name + ': ' + String(data.get('name')).trim(),
      labels.company + ': ' + String(data.get('company')).trim(),
      labels.email + ': ' + String(data.get('email')).trim(),
      labels.sector + ': ' + sector,
      labels.language + ': ' + language,
      Object.hasOwn(programLabels, program) ? g.program + ': ' + programLabels[program] : '',
      data.get('sence') ? g.senceLabel + ': ' + g.yes : '',
      data.get('message') ? labels.needs + ': ' + String(data.get('message')).trim() : '',
    ].filter(Boolean).join('\n');
    const url = 'https://wa.me/' + form.dataset.phone + '?text=' + encodeURIComponent(message);
    recordEvent('contact_prepared', { program, sector: String(data.get('sector')), language: String(data.get('language')), sence: Boolean(data.get('sence')) });
    window.open(url, '_blank', 'noopener,noreferrer');
    if (status) {
      status.replaceChildren(document.createTextNode(c.status));
      const fallback = document.createElement('button');
      fallback.type = 'button';
      fallback.addEventListener('click', () => {
        recordEvent('click_whatsapp');
        window.open(url, '_blank', 'noopener,noreferrer');
      });
      fallback.textContent = c.fallback; status.append(fallback);
    }
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-sector]').forEach(link => {
    link.addEventListener('click', () => {
      const sector = document.querySelector<HTMLSelectElement>('#contact-sector');
      const language = document.querySelector<HTMLSelectElement>('#contact-language');
      if (sector) sector.value = link.dataset.sector || '';
      if (language) language.value = 'ambos';
    });
  });
</script>
