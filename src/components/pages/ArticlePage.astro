---
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import { getMessages, localizedPath } from '../../i18n/index.js';
import { getResourceMessages } from '../../i18n/resources/index.js';
import { getCommercialMessages } from '../../i18n/commercial/index.js';
import { site } from '../../data/site';
import '../../styles/resources.css';
interface Props { locale?: string; slug: string; }
const { locale = 'es', slug } = Astro.props;
const article = getMessages(locale).articles.find(item => item.slug === slug);
if (!article) throw new Error(`Unknown article: ${slug}`);
const r = getResourceMessages(locale);
const programmes = getCommercialMessages(locale).pages;
const home = localizedPath(locale);
const resources = localizedPath(locale, '/recursos');
const articlePath = localizedPath(locale, `/noticias/${slug}`);
const corporate = localizedPath(locale, '/diagnostico-ingles-empresas');
const consultation = slug === 'evaluar-ingles-equipo-hotelero'
  ? corporate + '#consulta-equipo'
  : slug === 'capacitacion-idiomas-turnos'
    ? home + '#contacto'
    : `${home}?program=${slug === 'la-importancia-de-saber-ingles' ? 'idiomas-para-hoteleria&sector=hoteleria' : 'ingles-para-empresas'}&language=ingles#contacto`;
const sectionLabel = (title: string) => title.replace(/^\d+\.\s*/, '');
const related = article.relatedPrograms.filter(relatedSlug => programmes[relatedSlug]).map(relatedSlug => ({slug: relatedSlug, ...programmes[relatedSlug]}));
const furtherGuides = getMessages(locale).articles.filter(item => item.slug !== slug).slice(0, 2);
const articleData = {
  '@type': 'Article', headline: article.title, description: article.description,
  image: new URL(`/images/${article.image}.webp`, site.url).href,
  mainEntityOfPage: new URL(localizedPath(locale, `/noticias/${slug}`), site.url).href,
  author: { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.name, url: site.url + '/nosotros/' },
  publisher: { '@id': `${site.url}/#organization` },
};
---
<Layout locale={locale} title={`${article.title} | Elemental Studios`} description={article.description} image={`/images/${article.image}.webp`} ogType="article" structuredData={articleData} breadcrumbs={[{name: r.home, url: home}, {name: r.label, url: resources}, {name: article.title, url: articlePath}]}>
  <article class="resource-guide">
    <header class="guide-hero"><div class="container"><nav class="resources-breadcrumb" aria-label={r.breadcrumb}><a href={home}>{r.home}</a><Icon name="chevron" size={12} /><a href={resources}>{r.label}</a></nav><p class="resource-category"><Icon name="book" size={18} />{article.category}</p><h1>{article.title}</h1><p class="guide-lead">{article.lead}</p><p class="guide-byline">{r.publisher} <a href={localizedPath(locale, '/nosotros')}>{site.legalName}</a></p></div></header>
    <div class="container guide-reading-layout">
      <aside class="guide-sidebar">
        <details class="guide-contents" open><summary>{r.contents}<Icon name="chevron" size={13} /></summary><nav aria-label={r.contents}>{article.sections.map((section, index) => <a href={`#${section.id}`}><span>0{index + 1}</span>{sectionLabel(section.title)}</a>)}</nav></details>
        <div class="guide-side-promo"><Icon name="target" size={25} /><h2>{r.sideTitle}</h2><p>{r.sideText}</p><a href={consultation}>{r.corporateCta}<Icon name="arrow" size={16} /></a></div>
        <div class="guide-related-programmes"><h2>{r.related}</h2>{related.map(program => <a href={localizedPath(locale, `/${program.slug}`)}>{program.label}<Icon name="arrow" size={15} /></a>)}</div>
      </aside>
      <div class="guide-reading-content">
        <section class="guide-takeaways" aria-labelledby="guide-takeaways-title"><h2 id="guide-takeaways-title">{r.takeaways}</h2><ul>{article.keyPoints.map(point => <li><Icon name="checkCircle" size={18} /><span>{point}</span></li>)}</ul></section>
        <figure class="guide-cover"><img src={`/images/${article.image}.webp`} width="1000" height="600" alt={article.alt} loading="lazy" /></figure>
        {article.sections.map(section => <section class="guide-content-section" id={section.id}><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{section.checklist.length > 0 && <ul class="guide-checklist" aria-label={r.checklist}>{section.checklist.map(item => <li><Icon name="check" size={17} /><span>{item}</span></li>)}</ul>}{section.table && <><p class="guide-table-hint">{r.tableHint}</p><div class="guide-table-wrap" role="region" aria-label={section.title} tabindex="0"><table><thead><tr>{section.table.columns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody>{section.table.rows.map(row => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div></>}{section.example && <aside class="guide-example"><span><Icon name="message" size={18} />{r.example}</span><h3>{section.example.title}</h3><p>{section.example.text}</p></aside>}</section>)}
        <section class="guide-further" aria-labelledby="guide-further-title"><h2 id="guide-further-title">{r.moreGuides}</h2>{furtherGuides.map(guide => <a href={localizedPath(locale, `/noticias/${guide.slug}`)}><div><span>{guide.category}</span><h3>{guide.title}</h3></div><Icon name="arrow" size={21} /></a>)}</section>
        <a class="guide-back" href={resources}><Icon name="arrow" class="rotate" size={17} />{r.allResources}</a>
      </div>
    </div>
  </article>
  <section class="resource-bottom-cta"><div class="container resource-bottom-cta-inner"><div><p class="eyebrow">{r.nextStep}</p><h2>{r.ctaTitle}<br /><span class="text-gold">{r.ctaAccent}</span></h2><p>{r.ctaText}</p></div><a class="button button-gold" href={consultation}>{article.cta}<Icon name="arrow" size={19} /></a></div></section>
</Layout>
